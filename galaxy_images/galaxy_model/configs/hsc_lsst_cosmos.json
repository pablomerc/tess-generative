{
  "_comment": [
    "First HSC x LSST dual-encoder run (lsst/DECISIONS.md). Same architecture and",
    "variant as the HSC x Legacy baseline configs/neighbors_efficient.json; only the",
    "data mode, the survey pair, the step budget and the bookkeeping differ.",
    "data: COSMOS only, griz, n_input>=5 per band on anchors and LSST neighbour",
    "slots, seeded 5% validation slice, no downstream-holdout exclusion (probes",
    "deferred). model.lr_schedule stays 'paper' for comparability with the registry",
    "checkpoints (the epoch-boundary LR alternation documented in CLAUDE.md included).",
    "trainer: 20k steps at batch 64 ~ 40 epochs of 31,679 anchors; ~1 step/s on one",
    "MI210 -> 6-8 h incl. validation, fits one 12 h mi2101x slot.",
    "Launch: sbatch galaxy_images/galaxy_model/lsst/hsc_lsst_train.sbatch",
    "Smoke: sbatch -p devel -t 25:00 galaxy_images/galaxy_model/lsst/hsc_lsst_train.sbatch",
    "         --set trainer.num_steps=60 --set trainer.val_check_interval=30 --set wandb.enabled=false"
  ],
  "run": {
    "variant": "neighbors_all_attn",
    "output_dir": "/work1/jeroenaudenaert/pablomer/outputs/hsc_lsst",
    "shared_checkpoint_dir": null
  },
  "data": {
    "mode": "hsc_lsst_ram48",
    "lsst_data_dir": "/work1/jeroenaudenaert/pablomer/data/lsst_efficient",
    "hsc48_data_dir": "/work1/jeroenaudenaert/pablomer/data/efficient_neighs_48",
    "lsst_field": "COSMOS",
    "lsst_min_n_input": 5,
    "max_neighbors": 5,
    "random_neighbors": false,
    "val_ratio": 0.05,
    "batch_size": 64,
    "num_workers": 4,
    "pin_memory": true,
    "drop_last_train": true,
    "save_heldout_validation": false
  },
  "model": {
    "in_channels": 4,
    "cond_channels": 4,
    "image_size": 48,
    "model_channels": 128,
    "channel_mult": [1, 2, 4, 4],
    "layers_per_block": 2,
    "attention_head_dim": 8,
    "cross_attention_dim": 16,
    "pretrained_encoder": false,
    "concat_conditioning": false,
    "lr": 0.0001,
    "lr_schedule": "paper",
    "num_sample_images": 10,
    "num_mse_images": 32,
    "num_integration_steps": 250,
    "lambda_generative": 1.0,
    "lambda_geometric": 0.0,
    "num_umap_batches": 8,
    "mask_center": false,
    "all_attention": true,
    "figures_dir": null,
    "survey_names": ["hsc", "lsst"]
  },
  "trainer": {
    "seed": 42,
    "num_steps": 20000,
    "devices": 1,
    "accelerator": "auto",
    "strategy": "auto",
    "precision": "bf16-mixed",
    "h100_precision": "bf16-mixed",
    "h100_batch_size": 64,
    "auto_adjust_for_h100": false,
    "scale_steps_by_devices": false,
    "val_check_interval": 1000,
    "log_every_n_steps": 10,
    "num_sanity_val_steps": 0,
    "monitor_metric": "val/loss",
    "checkpoint_every_n_train_steps": 1000
  },
  "wandb": {
    "enabled": true,
    "project": "lsst-disentanglement",
    "name": "hsc-lsst-cosmos-griz-n5-5nb-20k",
    "group": "hsc_lsst",
    "tags": ["hsc_lsst", "cosmos", "griz", "ram48"],
    "job_type": "train",
    "log_model": false
  }
}
